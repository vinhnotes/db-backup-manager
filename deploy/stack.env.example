# Environment for the Portainer stack (deploy/docker-compose.portainer.yml).
# Paste into Stacks → Environment variables → Advanced mode, or use
# "Load variables from .env file". Do not commit a copy with real passwords.

# Required: your image repository WITHOUT a tag, e.g. registry.example.com/your-namespace/db-backup-manager
IMAGE=
IMAGE_TAG=latest
HOST_PORT=8088

ADMIN_USER=admin
# 12–72 bytes. Only used on first start; change it later in the web UI.
ADMIN_PASSWORD=
# Optional read-only UI login, username: viewer
VIEWER_PASSWORD=

# Database connections are configured in the web UI (Databases → Thêm kết nối).

# Docker network of the running PostgreSQL stack (see `docker network ls`).
# Required: existing Docker network shared with your database containers.
POSTGRES_NETWORK=

TZ=Asia/Ho_Chi_Minh
JOB_TIMEOUT=2h
MAX_UPLOAD_BYTES=10737418240
# Failed backups and cloud uploads are retried JOB_RETRIES times (0–10),
# waiting JOB_RETRY_DELAY, then twice as long each time.
JOB_RETRIES=2
JOB_RETRY_DELAY=2m
# Run a schedule once at startup if its run was missed while stopped.
CATCH_UP_MISSED=true
# Alert thresholds for notifications (0 turns an alert off):
# free space of BACKUP_DIR below DISK_ALERT_PERCENT %, a backup more than
# BACKUP_SHRINK_PERCENT % smaller than the previous one, and no successful
# backup of a scheduled database for longer than BACKUP_MAX_AGE.
DISK_ALERT_PERCENT=10
BACKUP_SHRINK_PERCENT=50
BACKUP_MAX_AGE=24h
# Set (16+ characters) to enable GET /metrics for Prometheus (Bearer token).
METRICS_TOKEN=
# HTTPS. self-signed (default): the certificate is generated on first start
# and kept in DATA_DIR/tls. Add the server's IPs/domains (comma-separated) to
# TLS_HOSTS so the certificate matches the address you open. Use file with
# TLS_CERT_FILE/TLS_KEY_FILE for your own certificate, or off for plain HTTP
# (e.g. behind an HTTPS reverse proxy; then set COOKIE_SECURE=true).
TLS_MODE=self-signed
TLS_HOSTS=
TLS_CERT_FILE=
TLS_KEY_FILE=
# Defaults to true when TLS_MODE is not off.
COOKIE_SECURE=

# Storage. Leave empty to use Docker named volumes (recommended, no setup).
# Or set absolute host paths owned by 999:999, e.g. /opt/backups/db.
DATA_DIR=
BACKUP_DIR=

# Optional Google Drive web OAuth; register the exact callback URL with Google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
